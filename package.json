    "test:its-display": "node scripts/test-its-lane-display.mjs",
    "test:connected": "node scripts/test-connected-course.mjs",
    "test:difficulty": "node scripts/test-course-difficulty.mjs",
    "test:ai": "node scripts/test-course-recommendation.mjs",
    "test:pool": "node scripts/test-gemini-key-pool.mjs",
    "test:ai:live": "node scripts/verify-gemini-live.mjs",
    "test:goals": "node scripts/test-practice-goals.mjs",
    "test:regions": "node scripts/test-region-saved-courses.mjs",
    "test:viewt": "python -B scripts/test-level55-traffic.py",
    "test:viewt:data": "node scripts/test-level55-data.mjs",
