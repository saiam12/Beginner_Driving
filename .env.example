# Server only. Never prefix a Gemini key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Server-only shared pool. single uses GEMINI_API_KEY; sheets never falls back.
GEMINI_POOL_MODE=single
GEMINI_POOL_URL=
GEMINI_POOL_TOKEN=
GEMINI_POOL_USER=
GEMINI_API_KEYS="{}"
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash
